# Seeds CRM Backend Environment Configuration
# Use this template for local development or production deployments.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://innocensseedsof_db_user:LE5ToCTGTiYFB58m@cluster0.hpgqbld.mongodb.net/seeds_crm?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=seeds_crm_dev_jwt_secret_isolated_2026

# Allowed Frontend Origins (comma-separated for multiple origins)
# For Local: http://localhost:3000
# For Production: https://seedscrm.seedsofinnocens.com
# Can specify multiple: http://localhost:3000,https://seedscrm.seedsofinnocens.com
CORS_ORIGIN=http://localhost:3000,https://seedscrm.seedsofinnocens.com

# Meta / Facebook Lead Ads Webhook Configuration
META_WEBHOOK_VERIFY_TOKEN=seeds_crm_meta_test_verify_token_2026
META_APP_SECRET=ea79505ec45a82036951479b0edc20c8
META_APP_ID=1662041768876537

# Meta OAuth Redirect URI (must match your frontend origin)
# For Local: http://localhost:3000/admin/integrations/meta/callback
# For Production: https://seedscrm.seedsofinnocens.com/admin/integrations/meta/callback
META_OAUTH_REDIRECT_URI=https://seedscrm.seedsofinnocens.com/admin/integrations/meta/callback
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Smartflo Dialer Integration Configuration
SMARTFLO_API_BASE_URL=https://api-smartflo.tatateleservices.com/v1
SMARTFLO_LOGIN_ID=your_smartflo_login_email_or_id
SMARTFLO_PASSWORD=your_smartflo_login_password

# Sync Target Type: 'contact' (Contact Group API) or 'broadcast' (Broadcast Lead List API)
# Defaults to 'contact' for backward compatibility
SMARTFLO_SYNC_TYPE=contact

# Target IDs for each sync type (kept strictly distinct)
SMARTFLO_CONTACT_GROUP_ID=58109
SMARTFLO_BROADCAST_LIST_ID=1075349
# Legacy alias for backward compatibility:
SMARTFLO_LEAD_LIST_ID=

SMARTFLO_SYNC_ENABLED=false
SMARTFLO_WEBHOOK_SECRET=your_random_webhook_secret_here
SMARTFLO_API_KEY=your_crm_api_key_for_smartflo_pull_here
# Account-approved outbound Caller ID / Pilot DID for Click-to-Call
SMARTFLO_CALLER_ID=919876543210
