# Seeds CRM Backend Environment Configuration
# NOTE: Replace placeholder values with development credentials.
# NEVER connect this project to any production database or reuse production secrets.

PORT=5000
NODE_ENV=development

# MongoDB Atlas Development Database
# Ensure database name is seeds_crm_dev and user has isolated dev permissions
MONGODB_URI=mongodb+srv://<dev_user>:<dev_password>@<dev_cluster>.mongodb.net/seeds_crm_dev?retryWrites=true&w=majority

# JWT Authentication Secret (Development Only)
JWT_SECRET=seeds_crm_dev_secret_key_change_in_local_env

# Allowed Frontend Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Meta / Facebook Lead Ads Webhook & Graph API Configuration
# Meta App ID from Meta App Dashboard > App settings > Basic
META_APP_ID=your_meta_app_id_here
# App Secret from Meta App Dashboard > App settings > Basic (used to verify X-Hub-Signature-256 and OAuth exchange)
META_APP_SECRET=your_meta_app_secret_here
# Secret token configured in the Meta App Dashboard Webhooks configuration
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here
# OAuth Redirect URI configured in Meta Login settings
META_OAUTH_REDIRECT_URI=http://localhost:3000/admin/integrations/meta/callback
# Page Access Token with leads_retrieval permission to fetch form answers from Graph API (optional static fallback)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
# Meta Graph API Version (defaults to v21.0 or v26.0)
META_GRAPH_API_VERSION=v21.0
